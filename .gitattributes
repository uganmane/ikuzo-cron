# 统一换行符，避免 Windows 检出时产生 CRLF 噪音
* text=auto eol=lf

# 二进制文件不要做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# 锁文件在 diff 里折叠显示，别刷屏
package-lock.json -diff linguist-generated=true

# 语言标注（GitHub 语言统计用）
*.ts   text diff=typescript
*.tsx  text diff=typescript
*.vue  text
*.mjs  text
