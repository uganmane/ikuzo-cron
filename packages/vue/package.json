{
  "name": "cron-kit-vue",
  "version": "0.2.0",
  "description": "Vue 3 版 Cron 表达式可视化组件：支持 v-model 与表单校验，可在弹窗中配置并回传表达式，零运行时依赖。",
  "keywords": [
    "cron",
    "vue",
    "vue3",
    "vue-component",
    "cron-expression",
    "quartz",
    "crontab",
    "scheduler",
    "form"
  ],
  "license": "MIT",
  "author": "lixiang <zoroikuzo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uganmane/ikuzo-cron.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/uganmane/ikuzo-cron/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/uganmane/ikuzo-cron/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ../../scripts/copy-styles.mjs vue",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "cron-kit-core": "^0.2.0"
  },
  "peerDependencies": {
    "vue": ">=3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
