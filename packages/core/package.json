{
  "name": "cron-kit-core",
  "version": "0.2.0",
  "description": "零依赖的 Cron 表达式引擎：解析、校验、中文描述、可视化配置互转与最近执行时间计算，支持 Quartz / Spring / Linux Crontab / Node Cron 四种语法。",
  "keywords": [
    "cron",
    "crontab",
    "quartz",
    "spring",
    "cron-expression",
    "cron-parser",
    "next-run-time",
    "scheduler"
  ],
  "license": "MIT",
  "author": "lixiang <zoroikuzo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uganmane/ikuzo-cron.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/uganmane/ikuzo-cron/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/uganmane/ikuzo-cron/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/styles.js",
    "./dist/styles.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js",
      "require": "./dist/styles.cjs",
      "default": "./dist/styles.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/emit-css.mjs",
    "dev": "tsup --watch",
    "test": "npm run build && node --test test/core.test.mjs",
    "test:only": "node --test test/core.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
